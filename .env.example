# Runtime
HIRO2_ENV=development
HIRO2_LOG_LEVEL=INFO
HIRO2_RUN_DIR=data/runs
HIRO2_OBJECT_DIR=data/objects

# Storage（变量名与代码一致：DATABASE_URL / NEO4J_URI / NEO4J_USER / NEO4J_PASSWORD；
# 默认值对齐 docker-compose.yml 本地容器，起库后照抄即用。不配置则离线模式，文件产物为权威）
DATABASE_URL=postgresql://hiro2:hiro2@localhost:5433/hiro2
CORS_ORIGINS=http://localhost:3000
# Railway 上填写 Web 服务公网域名，多个值用逗号分隔
RESUME_OBJECTS_DIR=data/objects/resumes
RESUME_ARCHIVE_PATH=data/processed/candidates/resume-archive.jsonl
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=hiro2password

# LLM provider（Anthropic Messages 协议网关；不要用 ANTHROPIC_* 命名，
# 那是 Claude Code/SDK 的保留环境变量，进程环境会覆盖 .env 导致配置串线）
HIRO2_LLM_PROVIDER=anthropic   # anthropic | mock
HIRO2_LLM_BASE_URL=
HIRO2_LLM_MODEL=
HIRO2_LLM_API_KEY=

# Temporal ingestion
HIRO2_RSS_INTERVAL_MINUTES=180
HIRO2_FORECAST_HORIZON_DAYS=90

# JD 快照后台采集（compose/生产置 true：API 启动即周期采集+解析映射；
# 周期 HIRO2_SNAPSHOT_INTERVAL_HOURS=24，LLM 分析 HIRO2_SNAPSHOT_ANALYZE=true）
HIRO2_SNAPSHOT_ENABLED=false
