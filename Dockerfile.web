FROM node:22-slim

WORKDIR /app
RUN corepack enable
COPY apps/web/package.json apps/web/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY apps/web ./
RUN pnpm build

ENV NODE_ENV=production
ENV NEXT_PUBLIC_USE_MOCK=false
ENV NEXT_PUBLIC_API_BASE_URL=http://api:8000
EXPOSE 3000
CMD ["pnpm", "start"]
